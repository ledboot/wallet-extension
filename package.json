{
  "name": "wallet-extension",
  "displayName": "Zent Wallet Extension",
  "description": "A secure cryptocurrency wallet for managing ZENT tokens and blockchain assets. Send, receive, and track your crypto holdings with enhanced privacy and security.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode development",
    "build:prod": "tsc && vite build --mode production",
    "debug": "bun run build:dev && ./scripts/debug.sh",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preinstall": "npx only-allow bun",
    "prepare": "husky install"
  },
  "dependencies": {
    "@metamask/obs-store": "^9.1.0",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.3.0",
    "@sentry/browser": "^10.45.0",
    "@sqlite.org/sqlite-wasm": "3.50.3-build1",
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/vite": "^4.1.14",
    "base58-js": "^3.0.3",
    "big-integer": "^1.6.52",
    "bitcoinjs-lib": "^6.1.7",
    "bitcore-lib": "^10.10.7",
    "browser-passworder": "^2.0.3",
    "bs58check": "^4.0.0",
    "compare-versions": "^6.1.1",
    "crypto-js": "^4.2.0",
    "debounce": "^2.2.0",
    "ecpair": "^3.0.0",
    "eventemitter3": "^5.0.1",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.1.0",
    "lucide-react": "^0.540.0",
    "posthog-js": "^1.363.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1",
    "react-router-dom": "^7.7.1",
    "sonner": "^2.0.7",
    "tiny-secp256k1": "^2.2.4",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@crxjs/vite-plugin": "^2.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@types/bitcore-lib": "^0.15.6",
    "@types/chrome": "^0.0.268",
    "@types/crypto-js": "^4.2.2",
    "@types/ecurve": "^1.0.3",
    "@types/jsbn": "^1.2.33",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.19",
    "bigi": "^1.4.2",
    "daisyui": "^5.0.46",
    "dotenv": "^17.2.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^1.16.0",
    "prettier": "^3.2.5",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-wasm": "^3.5.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.1.10",
  "engines": {
    "node": "22.x",
    "bun": ">=1.1.10"
  }
}
